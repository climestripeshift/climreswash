# Research-beta configuration TEMPLATE. Copy to beta.env on the host (never commit real values; beta.env is git-ignored).
# Nothing in this repository sets these; no secret is stored here.

# --- gateway -----------------------------------------------------------------------------------------------------------
NODE_ENV=production
BETA_ENV=hosted
BETA_AUTH_MODE=code
BETA_INGRESS_MODE=proxy
BETA_DATABASE_URL=postgresql://CONFIGURE_IN_SECRET_MANAGER
BETA_SESSION_SECONDS=28800
BETA_PUBLIC_ORIGIN=https://climreswash.in
BETA_HASH_KEY=CHANGE_ME_32_PLUS_RANDOM_CHARS
BETA_LISTEN_HOST=127.0.0.1
# Set 0.0.0.0 only behind approved HTTPS hosting; every request still requires the proxy origin key.

BETA_CORE_URL=http://127.0.0.1:8765
BETA_STATIC_DIR=/app/dist/beta
BETA_PORT=5100

# --- limits and spend safeguards (defaults are conservative; see plan section 8) -------------------------------------
BETA_LIMIT_PER_MINUTE=3
BETA_LIMIT_PER_HOUR=20
BETA_LIMIT_PER_DAY=20
BETA_LIMIT_GLOBAL_PER_DAY=200
BETA_GLOBAL_CONCURRENT=2
BETA_REQUEST_TIMEOUT_MS=120000
BETA_DAILY_GPU_SECONDS=7200

# --- Core workers (profile that disables restricted-licence tools and data) ------------------------------------------
# With BHOOMI_BETA_COLOCATE=1 the supervisor derives Core's model settings from the relay's (loopback base URL, pinned model,
# experimental gate, registry path), so the BHOOMI_LLM_* values below are only needed for a manually started Core.
BHOOMI_DEPLOYMENT_PROFILE=cloud_beta
BHOOMI_LLM_BACKEND=openai_compat
BHOOMI_LLM_EXPERIMENTAL=1
BHOOMI_LLM_MODEL_ID=adapter-B-full2ep-experimental-machine-verified
BHOOMI_LLM_REGISTRY=/app/registry/models.json
BHOOMI_LLM_MODEL=bhoomi-llm-v1-ckpt160
BHOOMI_LLM_BASE_URL=http://127.0.0.1:8081/v1

# --- relay -> Runpod ---------------------------------------------------------------------------------------------------
# Option B (preferred when intermittent): Runpod Serverless. Credential: RUNPOD_API_KEY (held by the relay only).
RELAY_UPSTREAM=https://api.runpod.ai/v2/CHANGE_ME_ENDPOINT_ID/openai/v1
RUNPOD_API_KEY=CHANGE_ME
# Option A (short supervised session): a Pod behind Runpod's HTTPS proxy, in front of which the in-Pod gate
# (deploy/beta/gpu-compatibility/start-pod-proxy.sh) is the ONLY exposed HTTP surface. Credential: the gate's edge key.
#   RELAY_UPSTREAM=https://<pod-id>-8000.proxy.runpod.net/v1
#   RELAY_UPSTREAM_KEY=CHANGE_ME_32_PLUS_RANDOM_CHARS     # same value as the Pod's BHOOMI_EDGE_KEY; never the Runpod account key
RELAY_MODEL=bhoomi-llm-v1-ckpt160
RELAY_BASE_MODEL=Qwen/Qwen3-4B-Instruct-2507
RELAY_IDENTITY_TTL_S=300
RELAY_MAX_TOKENS=600
RELAY_TIMEOUT_S=150
RELAY_CONCURRENCY=2
RELAY_DAILY_REQUEST_CAP=1200

# --- billing / shutdown evidence producer (runs next to the relay; the relay refuses without <=300 s old evidence) ----
# Use a RESTRICTED/read-only Runpod key here, different from the one the relay uses. Pod mode requires it explicitly.
RUNPOD_MONITOR_API_KEY=CHANGE_ME_RESTRICTED_READ_ONLY_KEY
MONITOR_INTERVAL_S=60
MONITOR_MAX_WORKERS=1
# Operator attestation, set to 1 only after confirming auto-pay is OFF in the Runpod console (not readable through the API).
MONITOR_AUTOPAY_DISABLED=0
# Pod mode only: stop the approved Pod automatically when spend or uptime ceilings are breached (needs a key with stop rights).
MONITOR_STOP_POD_ON_BREACH=0
MONITOR_POD_MAX_UPTIME_S=28800

# Disabled until separate deployment, artifact and budget approval.
BETA_CLOUD_APPROVED=0
# Replit secrets are environment variables, not files: set BETA_APPROVAL_JSON to the manifest JSON and the supervisor writes it
# (mode 0600) under BETA_RUN_DIR. BETA_APPROVAL_MANIFEST may instead name an existing file.
# BETA_APPROVAL_JSON={"approved":true,...}
BETA_APPROVAL_MANIFEST=/run/secrets/beta-approval.json
BETA_RESERVATION_SECONDS=300
BETA_MONTHLY_GPU_SECONDS=324000
RELAY_BUDGET_DB=/data/relay-budget.sqlite
# RELAY_APPROVAL_FILE / RELAY_BILLING_FILE default to the supervisor-managed files under BETA_RUN_DIR.
RELAY_MONTHLY_CAP_MICRO_USD=90000000
RELAY_CALL_RESERVATION_MICRO_USD=100000

# Required for the existing Express proxy -> private gateway and signed Core snapshots.
# Store only in production Secrets; never in a frontend/VITE variable.
BETA_ORIGIN_KEY=CHANGE_ME_32_PLUS_RANDOM_CHARS

# Replit cohosting is opt-in; npm run start still serves the existing public website.
BHOOMI_BETA_COLOCATE=0
# Default TLS for production remote PostgreSQL. Select replit-helium ONLY for the
# app-internal helium/heliumdb endpoint confirmed reachable in the published runtime.
BETA_DB_TRANSPORT=tls
# The URL must use the dedicated restricted beta role, never the public-site owner.
# Explicitly apply migrations 001–003 + provision-beta-role.example.sql after approval.
# Replit build/runtime must include Python3, psycopg[binary] and tsx dependencies.
# Gateway starts disarmed by default; Core/relay start only with existing cloud approval gates.
# BETA_CORE_ROOT defaults to research/bhoomi_ai_core_v0 in the published checkout.
# Must be INSIDE Core's data root (research/bhoomi_ai_core_v0/data/...): Core's cloud_beta profile refuses any other directory
# (the old /tmp/bhoomi-core default crashed Core at start-up). Leave unset to use data/beta-cache.
# BETA_CORE_CACHE_DIR=research/bhoomi_ai_core_v0/data/beta-cache

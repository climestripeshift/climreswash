# Separate showcase configuration; OFF unless the owner explicitly enables a supervised session.
BHOOMI_DEMO_ENABLED=0
# Configure ONLY in the existing host's private environment, after owner approval:
# BHOOMI_DEMO_ENDPOINT=https://<pod-id>-8000.proxy.runpod.net/v1/chat/completions
# BHOOMI_DEMO_EDGE_KEY=<existing authenticated Pod gate edge key; never the Runpod account key>
# BHOOMI_DEMO_UNTIL=<absolute ISO-8601 UTC expiry; at most 30 minutes from activation>
# Leave BETA_CLOUD_APPROVED off. Keep all existing PIN/admin/proxy/database settings.
